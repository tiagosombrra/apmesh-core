  "gate_conditions": {
    "E0": { "pass": "revision-bound scope classification records only infrastructure changes", "blocked": "scientific-core or protected contract bytes differ" },
    "E1": { "pass": "strict profile validates with every required declaration", "blocked": "unknown, duplicate, or missing declaration" },
    "E2": { "pass": "candidate, inputs, plan, tools and prerequisite identities revalidate", "blocked": "any observed identity differs" },
    "E3": { "pass": "all planned commands retain complete provenance", "blocked": "command failure, timeout, or lifecycle mismatch" },
    "E4": { "pass": "all bundles validate exact artifacts, inventory, and derivations", "blocked": "missing, extra, stale, or malformed artifact" },
    "E5": { "pass": "both replays agree under declared rules", "blocked": "validated semantic claim difference" },
    "E6": { "pass": "all four cells compare after E5", "blocked": "cross-cell claim difference or incomplete matrix" },
    "E7": { "pass": "eight negative fixtures reject and qualified prerequisite protocols are linked", "blocked": "a rejection fails or prerequisite evidence is absent" }
