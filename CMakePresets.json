{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC 13 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-debug",
      "cacheVariables": {
        "APMESH_ENABLE_QUALIFICATION_TESTS": "OFF",
        "APMESH_USE_LIBCXX": "OFF",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-13"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC 13 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-release",
      "cacheVariables": {
        "APMESH_ENABLE_QUALIFICATION_TESTS": "OFF",
        "APMESH_USE_LIBCXX": "OFF",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "/usr/bin/g++-13"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang 18 libc++ Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-debug",
      "cacheVariables": {
        "APMESH_ENABLE_QUALIFICATION_TESTS": "OFF",
        "APMESH_USE_LIBCXX": "ON",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-18"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang 18 libc++ Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-release",
      "cacheVariables": {
        "APMESH_ENABLE_QUALIFICATION_TESTS": "OFF",
        "APMESH_USE_LIBCXX": "ON",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-18"
      }
    },
    {
      "name": "gcc-debug-qualification",
      "displayName": "GCC 13 Debug with qualification tests",
      "inherits": "gcc-debug",
      "binaryDir": "${sourceDir}/build/gcc-debug-qualification",
      "cacheVariables": {
        "APMESH_ENABLE_QUALIFICATION_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc-debug", "configurePreset": "gcc-debug" },
    { "name": "gcc-release", "configurePreset": "gcc-release" },
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "gcc-debug-qualification", "configurePreset": "gcc-debug-qualification" }
  ],
  "testPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fast",
      "configurePreset": "gcc-debug",
      "filter": {
        "include": {
          "label": "fast"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "integration-gcc-debug",
      "configurePreset": "gcc-debug",
      "filter": {
        "include": {
          "label": "integration"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "integration-clang-debug",
      "configurePreset": "clang-debug",
      "filter": {
        "include": {
          "label": "integration"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "qualification-gcc-debug",
      "configurePreset": "gcc-debug-qualification",
      "filter": {
        "include": {
          "label": "qualification"
        }
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
